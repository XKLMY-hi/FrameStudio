{
  "name": "live2d-pocket-studio",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "description": "Offline portable Live2D timeline and compositing studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.ts",
    "start": "electron .",
    "serve": "node backend/standalone.mjs",
    "package": "node scripts/package.mjs",
    "qa": "node --import tsx scripts/curves-v251-qa.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
